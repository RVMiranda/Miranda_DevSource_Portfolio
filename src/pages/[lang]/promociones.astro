---
import Layout from "../../layouts/Layout.astro";
import Contact from "../../components/Contact.astro";
import { locales, type Locale } from "../../config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const text =
  lang === "es"
    ? {
        title: "Promociones de desarrollo web en Mérida",
        description:
          "Oferta de lanzamiento de Miranda DevSource: 20% de descuento en landing pages, hasta 15% en sistemas y aplicaciones, y cotización sin costo.",
        label: "OFERTA DE LANZAMIENTO / MÉRIDA, YUCATÁN",
        headline: "Tu proyecto puede comenzar hoy.",
        intro:
          "Una oportunidad para lanzar tu presencia digital o convertir una idea en una herramienta funcional con un proceso claro y acompañamiento directo.",
        primaryCta: "Solicitar cotización",
        secondaryCta: "Conocer el proceso",
        offersLabel: "01 / BENEFICIOS DE LANZAMIENTO",
        offersTitle: "Más impulso para dar el primer paso.",
        offersIntro:
          "La cotización es gratuita y sin compromiso. Revisamos juntos el objetivo, el alcance y la alternativa adecuada antes de tomar una decisión.",
        offers: [
          {
            value: "20%",
            qualifier: "de descuento",
            title: "Landing pages",
            description:
              "Una página enfocada en presentar tu negocio, servicio, producto o campaña con claridad y una llamada a la acción definida.",
            features: [
              "Hosting incluido durante el primer año",
              "Dominio incluido durante el primer año",
              "Diseño adaptable a dispositivos móviles",
              "Configuración técnica para publicación",
            ],
          },
          {
            value: "15%",
            qualifier: "hasta de descuento",
            title: "Sistemas y aplicaciones",
            description:
              "Soluciones a medida para digitalizar procesos, organizar información o acercar un servicio a tus usuarios.",
            features: [
              "Sistemas y plataformas web",
              "Aplicaciones móviles",
              "Definición inicial del alcance",
              "Avances y validaciones durante el desarrollo",
            ],
          },
        ],
        paymentLabel: "02 / FACILIDADES DE PAGO",
        paymentTitle: "Hasta 6 meses sin intereses.",
        paymentText:
          "Disponible en pagos presenciales en Mérida. La cantidad de mensualidades y su disponibilidad se confirman al cotizar, de acuerdo con el monto y el medio de pago aplicable.",
        includedLabel: "03 / DESDE EL PRIMER CONTACTO",
        includedTitle: "Claridad antes de construir.",
        included: [
          ["Cotización sin costo", "Recibe una propuesta inicial sin pagar por solicitarla."],
          ["Sin compromiso", "Conoce alcance, inversión y condiciones antes de decidir."],
          ["Atención directa", "Hablas con la persona responsable de diseñar y desarrollar tu solución."],
          ["Proceso documentado", "Cada proyecto parte de objetivos, entregables y acuerdos claros."],
        ],
        terms:
          "Promoción sujeta a disponibilidad y a las características de cada proyecto. Los descuentos no son acumulables. El dominio incluido está sujeto a disponibilidad; la renovación de dominio y hosting después del primer año se cotiza por separado. Las condiciones definitivas se indican en cada propuesta.",
      }
    : {
        title: "Web development promotions in Mérida",
        description:
          "Miranda DevSource launch offer: 20% off landing pages, up to 15% off systems and applications, and a free, no-obligation quote.",
        label: "LAUNCH OFFER / MÉRIDA, YUCATÁN",
        headline: "Your project can start today.",
        intro:
          "An opportunity to launch your digital presence or turn an idea into a functional tool through a clear process and direct support.",
        primaryCta: "Request a quote",
        secondaryCta: "Explore the process",
        offersLabel: "01 / LAUNCH BENEFITS",
        offersTitle: "More momentum for the first step.",
        offersIntro:
          "Your quote is free and carries no obligation. We review the goal, scope and right approach together before you make a decision.",
        offers: [
          {
            value: "20%",
            qualifier: "off",
            title: "Landing pages",
            description:
              "A focused page that presents your business, service, product or campaign clearly and leads visitors toward a defined action.",
            features: [
              "Hosting included for the first year",
              "Domain included for the first year",
              "Responsive design for mobile devices",
              "Technical launch configuration",
            ],
          },
          {
            value: "15%",
            qualifier: "up to off",
            title: "Systems and applications",
            description:
              "Custom solutions to digitize processes, organize information or bring a service closer to your users.",
            features: [
              "Web systems and platforms",
              "Mobile applications",
              "Initial scope definition",
              "Progress reviews throughout development",
            ],
          },
        ],
        paymentLabel: "02 / PAYMENT OPTIONS",
        paymentTitle: "Up to 6 interest-free monthly payments.",
        paymentText:
          "Available for in-person payments in Mérida. The number and availability of installments are confirmed with your quote according to the project amount and applicable payment method.",
        includedLabel: "03 / FROM THE FIRST CONVERSATION",
        includedTitle: "Clarity before construction.",
        included: [
          ["Free quote", "Receive an initial proposal at no cost."],
          ["No obligation", "Review scope, investment and terms before deciding."],
          ["Direct contact", "Speak with the person responsible for designing and building your solution."],
          ["Documented process", "Every project begins with clear objectives, deliverables and agreements."],
        ],
        terms:
          "Offer subject to availability and each project's requirements. Discounts cannot be combined. The included domain is subject to availability; domain and hosting renewals after the first year are quoted separately. Final conditions are specified in each proposal.",
      };
---

<Layout lang={lang} title={text.title} description={text.description} path="promociones/">
  <article class="promotion-page">
    <header class="wrap editorial-hero promotion-hero">
      <div class="promotion-hero-copy">
        <p class="eyebrow">{text.label}</p>
        <h1>{text.headline}</h1>
        <p class="lede">{text.intro}</p>
        <div class="hero-actions">
          <a class="button" href="#contact">{text.primaryCta}<span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`/${lang}/desarrollo-web-merida/`}>
            {text.secondaryCta}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="promotion-seal" aria-label={lang === "es" ? "Hasta veinte por ciento de descuento" : "Up to twenty percent off"}>
        <span>{lang === "es" ? "HASTA" : "UP TO"}</span>
        <strong>20%</strong>
        <span>{lang === "es" ? "DE DESCUENTO" : "OFF"}</span>
      </div>
    </header>

    <section class="promotion-offers section">
      <div class="wrap">
        <p class="eyebrow">{text.offersLabel}</p>
        <div class="section-heading">
          <h2>{text.offersTitle}</h2>
          <p>{text.offersIntro}</p>
        </div>
        <div class="offer-grid">
          {text.offers.map((offer, index) => (
            <article class="offer-card">
              <div class="offer-number"><span>0{index + 1}</span></div>
              <div class="offer-discount">
                <strong>{offer.value}</strong>
                <span>{offer.qualifier}</span>
              </div>
              <h3>{offer.title}</h3>
              <p>{offer.description}</p>
              <ul>
                {offer.features.map((feature) => <li>{feature}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="payment-band">
      <div class="wrap payment-grid">
        <p class="eyebrow">{text.paymentLabel}</p>
        <h2>{text.paymentTitle}</h2>
        <p>{text.paymentText}</p>
      </div>
    </section>

    <section class="wrap section">
      <p class="eyebrow">{text.includedLabel}</p>
      <h2 class="standalone-title">{text.includedTitle}</h2>
      <div class="promotion-benefits">
        {text.included.map(([title, description], index) => (
          <article>
            <span class="micro">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
      <p class="promotion-terms">{text.terms}</p>
    </section>

    <Contact lang={lang} />
  </article>
</Layout>
