---
import Layout from "../../layouts/Layout.astro";
import { locales, type Locale } from "../../config";
import { universityProjects } from "../../data/universityProjects";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const text =
  lang === "es"
    ? {
        title: "Proyectos de software",
        description:
          "Proyectos universitarios de Rafael Miranda en desarrollo web, aplicaciones iOS, APIs, microservicios, inteligencia artificial y sistemas de gestión.",
        label: "PROYECTOS / LABORATORIO DE APRENDIZAJE",
        headline: "Explorar, construir, aprender.",
        intro:
          "Una selección de proyectos académicos donde cada reto sirvió para probar una tecnología, comprender una arquitectura y convertir conceptos en software funcional.",
        verified: "Tecnologías verificadas en el repositorio",
        supplied: "Descripción proporcionada por el autor",
        source: "Ver código",
        cta: "¿Buscas una solución con esta misma curiosidad técnica?",
        contact: "Conversemos sobre tu proyecto",
      }
    : {
        title: "Software projects",
        description:
          "Rafael Miranda's university projects across web development, iOS applications, APIs, microservices, artificial intelligence and management systems.",
        label: "PROJECTS / LEARNING LAB",
        headline: "Explore, build, learn.",
        intro:
          "A selection of academic projects where each challenge became an opportunity to test a technology, understand an architecture and turn concepts into working software.",
        verified: "Technologies verified in the repository",
        supplied: "Description supplied by the author",
        source: "View code",
        cta: "Looking for a solution built with the same technical curiosity?",
        contact: "Let's discuss your project",
      };
---

<Layout
  lang={lang}
  title={text.title}
  description={text.description}
  path="proyectos/"
>
  <article class="listing-page">
    <header class="wrap editorial-hero">
      <p class="eyebrow">{text.label}</p>
      <h1>{text.headline}</h1>
      <p class="lede">{text.intro}</p>
      <div class="editorial-meta">
        <span>08 / CASES</span>
        <span>2022—2026</span>
        <span>MÉRIDA, YUCATÁN</span>
      </div>
    </header>

    <section class="projects-archive section">
      <div class="wrap archive-grid">
        {universityProjects.map((project, index) => (
          <article class="archive-card">
            <div class="archive-card-top">
              <span class="archive-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="eyebrow">{project.category[lang]}</span>
            </div>
            <h2>{project.name}</h2>
            <p>{project.description[lang]}</p>
            <ul class="chips archive-stack" aria-label="Technologies">
              {project.stack.map((item) => <li>{item}</li>)}
            </ul>
            <div class="archive-footer">
              <span class="micro">
                {project.verified ? text.verified : text.supplied}
              </span>
              <div class="archive-links">
                {project.links.map((link) => (
                  <a
                    class="text-link"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.links.length > 1 ? link.label : text.source} ↗
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap archive-cta">
      <h2>{text.cta}</h2>
      <a class="button" href={`/${lang}/#contact`}>
        {text.contact} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </article>
</Layout>
