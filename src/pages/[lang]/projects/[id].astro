---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Diagram from "../../../components/Diagram.astro";
import { locales, type Locale } from "../../../config";
import { copy } from "../../../i18n";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, id: project.id },
      props: { project },
    })),
  );
}
const { project } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = copy[lang];
const p = project.data[lang];
---

<Layout
  lang={lang}
  title={p.title}
  description={p.summary}
  path={`projects/${project.id}/`}
>
  <article class="wrap case-page">
    <a class="text-link" href={`/${lang}/#projects`}>
      ← {t.back}
    </a>
    <p class="eyebrow">
      {p.category} / {project.data.year}
    </p>
    <h1>{p.title}</h1>
    <p class="lede">{p.summary}</p>
    <ul class="chips">
      {project.data.tech.map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>
    <Diagram steps={p.steps} tone={project.data.tone} label={t.concept} />
    <div class="case-content">
      {[
        [t.challenge, p.challenge],
        [t.contribution, p.contribution],
        [t.solution, p.solution],
        [t.outcome, p.outcome],
      ].map(([heading, body], i) => (
        <section>
          <span class="micro">0{i + 1}</span>
          <div>
            <h2>{heading}</h2>
            <p>{body}</p>
          </div>
        </section>
      ))}
    </div>
    <div class="case-cta">
      <h2>{t.projectCta}</h2>
      <a class="button" href={`/${lang}/#contact`}>
        {t.cta} ↗
      </a>
    </div>
  </article>
</Layout>
