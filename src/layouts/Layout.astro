---
import "../styles/global.css";
import BrandLogo from "../components/BrandLogo.astro";
import { site, type Locale } from "../config";
import { copy } from "../i18n";
interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}
const {
  lang,
  title = site.name,
  description = copy[lang].intro,
  path = "",
  noindex = false,
} = Astro.props;
const t = copy[lang];
const canonical = new URL(`/${lang}/${path}`, Astro.site);
const navHrefs = [
  `/${lang}/#services`,
  `/${lang}/proyectos/`,
  `/${lang}/#about`,
];
const pageTitle =
  title === site.name
    ? `${site.name} — ${lang === "es" ? "Desarrollo de software" : "Software development"}`
    : `${title} | ${site.name}`;
const structuredData =
  path === ""
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: site.name,
          url: new URL(`/${lang}/`, Astro.site),
          inLanguage: lang === "es" ? "es-MX" : "en",
        },
        {
          "@context": "https://schema.org",
          "@type": "Person",
          name: "Rafael Valentín Miranda Cruz",
          alternateName: site.name,
          url: new URL(`/${lang}/`, Astro.site),
          jobTitle:
            lang === "es"
              ? "Ingeniero en Desarrollo de Tecnología y Software"
              : "Technology and Software Development Engineer",
          knowsAbout: [
            "Software development",
            "Full-stack development",
            "Web development",
            "Mobile applications",
            "Technical consulting",
            "Project management",
          ],
          sameAs: [site.github, site.linkedin],
        },
      ]
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        {(["es", "en"] as const).map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(`/${l}/${path}`, Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(`/es/${path}`, Astro.site)}
        />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_MX"}
    />
    <meta property="og:image" content={new URL("/social_web.jpg", Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="610" />
    <meta property="og:image:height" content="470" />
    <meta property="og:image:alt" content="Miranda DevSource" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/social_web.jpg", Astro.site)} />
    <meta name="twitter:image:alt" content="Miranda DevSource" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <header class="header wrap">
      <a
        class="brand"
        href={`/${lang}/`}
        aria-label={`Miranda DevSource — ${lang === "es" ? "Inicio" : "Home"}`}
      >
        <BrandLogo />
      </a>
      <nav
        aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}
      >
        {t.nav.slice(0, 3).map((label, i) => (
          <a href={navHrefs[i]}>
            {label}
          </a>
        ))}
      </nav>
      <div class="header-tools">
        <div
          class="language-switch"
          aria-label={lang === "es" ? "Seleccionar idioma" : "Select language"}
        >
          {(["es", "en"] as const).map((locale) =>
            locale === lang ? (
              <span class="language-current" lang={locale} aria-current="page">
                {locale.toUpperCase()}
              </span>
            ) : (
              <a
                href={`/${locale}/${path}`}
                lang={locale}
                hreflang={locale}
                aria-label={
                  locale === "en"
                    ? "Read this page in English"
                    : "Leer esta página en español"
                }
              >
                {locale.toUpperCase()}
              </a>
            ),
          )}
        </div>
        <button
          class="theme"
          type="button"
          aria-label={t.theme}
          title={t.theme}
          hidden
        >
          <span aria-hidden="true">◐</span>
        </button>
        <a class="button small header-contact" href={`/${lang}/#contact`}>
          {t.nav[3]} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap footer">
      <a
        class="brand footer-brand"
        href={`/${lang}/`}
        aria-label={`Miranda DevSource — ${lang === "es" ? "Inicio" : "Home"}`}
      >
        <BrandLogo />
      </a>
      <p>{t.footer}</p>
      <div>
        <span>© {new Date().getFullYear()}</span>
        <a href={`/${lang}/privacy/`}>{t.privacy}</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme");
      if (button) {
        button.hidden = false;
        button.addEventListener("click", () => {
          const root = document.documentElement;
          const current =
            root.dataset.theme ||
            (matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const next = current === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
        });
      }
    </script>
  </body>
</html>
